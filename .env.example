# ==============================================================================
# PromptPulse Environment Configuration Example
# ==============================================================================

DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-unique-strong-password

# Upstash Redis Cache (TLS connection or REST API)
REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6379
# UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

TAVILY_API_KEY=tvly-...
OPENROUTER_API_KEY=sk-or-v1-...
GROQ_API_KEY=gsk_...
DEEPSEEK_API_KEY=...
AGENTROUTER_API_KEY=...

# Optional shared AI gateway overrides
LLM_BASE_URL=
LLM_API_KEY=
